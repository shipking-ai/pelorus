{
  "name": "pelorus-browser",
  "version": "0.3.0",
  "description": "Pelorus: an open-source, privacy-focused desktop browser",
  "main": "src/main/main.js",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-force-exit --test-concurrency=1 --test-timeout=240000 \"test/e2e/*.test.js\"",
    "audit": "npm audit --omit=dev",
    "package": "electron-packager . Pelorus --platform=win32 --arch=x64 --out=out --overwrite --prune=true --ignore=\"^/(docs|test|scripts|out|\\.smoke|\\.git|README\\.md)\" --extra-resource=LICENSE --app-copyright=\"GPL-3.0-or-later\" --win32metadata.CompanyName=Pelorus --win32metadata.ProductName=Pelorus --win32metadata.FileDescription=Pelorus --win32metadata.OriginalFilename=Pelorus.exe",
    "sign": "powershell -NoProfile -File scripts/sign.ps1",
    "package:signed": "npm run package && npm run sign",
    "installer": "node scripts/make-installer.js",
    "site:build": "node scripts/build-site.js",
    "site:test": "node --test --test-force-exit --test-timeout=120000 \"test/site/*.test.js\"",
    "toolbox": "node scripts/build-toolbox.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "@ghostery/adblocker-electron-preload": "2.20.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "axe-core": "^4.14.0",
    "electron": "44.7.0",
    "electron-winstaller": "^5.4.4",
    "playwright-core": "1.64.0"
  },
  "author": "Pelorus contributors",
  "homepage": "https://github.com/shipking-ai/pelorus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shipking-ai/pelorus.git"
  },
  "bugs": {
    "url": "https://github.com/shipking-ai/pelorus/issues"
  }
}
